// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     String @id @default(uuid())
  username String @unique
  profilePic String @default("")
  password String
  email  String @unique
  members Members[]
  issueMapping IssueMapping[]
  comment Comments[]
  invites Invites[]
}
enum Role {
  user
  admin
}

model Org {
  id String @id @default(uuid())
  name String @unique
  members Members[]
  Boards   Boards[]
  invite Invites[]
  issues Issue[]
}
model Members {
  id String @id @default(uuid())
  userId String
  user    User @relation(fields: [userId] , references: [id])
  orgId    String
  org     Org @relation(fields: [orgId] , references: [id])
  role Role @default(user)

  @@unique([userId , orgId])
}
model Invites {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId] , references: [id])
  orgId String
  org Org @relation(fields: [orgId] , references: [id])
  accepted Boolean @default(false)


  @@unique([userId , orgId])
}

model Boards {
  id String @id @default(uuid())
  BoardName String @unique
  orgId      String
  org        Org @relation(fields: [orgId] , references: [id])
  issue   Issue[]
  section Section[]
}

model Issue {
  id String @id @default(uuid())
  title String
  description String @default("null")
  boardId  String
  board Boards @relation(fields: [boardId] , references: [id])
  issueMapping IssueMapping[]
  comments Comments[]
  orgId String 
  org Org @relation(fields: [orgId] , references: [id])
  status Status
}
enum Status {
  done 
  upcoming
  in_progress
}

model Section {
  id String @id @default(uuid())
  title String @unique
  boardId String
  board Boards @relation(fields: [boardId] , references: [id])
}

model IssueMapping {
  id String @id @default(uuid())
  issueId String
  issue  Issue @relation(fields: [issueId] , references: [id])
  userId String
  user  User @relation(fields: [userId] , references: [id])
}

model Comments {
  id String @id @default(uuid())
  comment String
  userId String
  user User @relation(fields: [userId] , references: [id])
  issueId String
  issue  Issue @relation(fields: [issueId] , references: [id])
}